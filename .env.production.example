# ─── Producción (docker-compose) ───────────────────────────────
# Dominio sin https:// (Caddy saca el certificado solo) y URL pública
DOMAIN=tukimedia.com
APP_URL="https://tukimedia.com"
NEXT_PUBLIC_TIMEZONE="America/Argentina/Buenos_Aires"

# Base de datos (la crea docker-compose). Usá una contraseña larga.
POSTGRES_PASSWORD=cambiar-por-una-contraseña-larga

# Clave secreta de la app: generá una con  openssl rand -hex 32
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Emails (Brevo, Resend, Google Workspace, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tuki Academia <hola@tukimedia.com>"

# Mercado Pago (credenciales de PRODUCCIÓN, empiezan con APP_USR-)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Opcionales
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BUNNY_TOKEN_KEY=
