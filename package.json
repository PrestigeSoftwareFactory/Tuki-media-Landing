{
  "name": "tuki-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Tuki Media Academy — landing, tienda y plataforma de cursos",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && node --env-file=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:sync-demo": "node --env-file=.env --import tsx prisma/sync-demo.ts",
    "setup": "prisma db push && node --env-file=.env --import tsx prisma/seed.ts",
    "create-admin": "node --import tsx scripts/create-admin.ts",
    "db:postgres": "node scripts/prisma-provider.mjs postgresql",
    "db:sqlite": "node scripts/prisma-provider.mjs sqlite",
    "test": "node --import tsx --test --test-reporter=spec tests/integration.test.ts",
    "test:e2e": "node --env-file=.env --import tsx --test --test-reporter=spec --test-concurrency=1 tests/e2e.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "bcryptjs": "3.0.3",
    "ffmpeg-static": "5.3.0",
    "hls.js": "1.7.3",
    "next": "15.5.27",
    "nodemailer": "6.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sanitize-html": "2.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.19",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/sanitize-html": "2.16.0",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
