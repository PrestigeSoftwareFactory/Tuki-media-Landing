# ── Base de datos ──────────────────────────────────────────────
# SQLite local para desarrollo. En producción: postgresql://user:pass@host:5432/tuki
DATABASE_URL="file:./dev.db"

# URL pública del sitio (sin barra final). Se usa en emails, pagos y webhooks.
APP_URL="http://localhost:3000"

# Zona horaria del negocio (fechas, clases en vivo, reportes)
NEXT_PUBLIC_TIMEZONE="America/Argentina/Buenos_Aires"

# Secreto para firmar tokens (videos, etc). Cambialo en producción.
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# ── Email (opcional). Si no se configura, los emails se muestran en la consola ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Tuki Academy <no-reply@tukimedia.com>"

# ── Pagos (opcional). Activá cada medio desde Admin → Configuración ──
# Credenciales en https://www.mercadopago.com.ar/developers/panel (usá las de prueba "TEST-..." para probar)
MERCADOPAGO_ACCESS_TOKEN=""
# Opcional: clave secreta del webhook (Tus integraciones → Webhooks) para validar la firma x-signature
MERCADOPAGO_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Bunny Stream (opcional, para videos con token firmado) ──
BUNNY_TOKEN_KEY=""

# ── Usuarios de prueba que crea el seed (npm run db:reset) ──
SEED_ADMIN_EMAIL="admin@tukimedia.com"
SEED_ADMIN_PASSWORD="elige-una-contraseña-segura"
SEED_STUDENT_EMAIL="alumno@tukimedia.com"
SEED_STUDENT_PASSWORD="elige-otra-contraseña"
